{
    "name": "cb/qr-code",
    "description": "WordPress QR Code Plugin with local generation",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.1",
        "endroid/qr-code": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "ChinmoyBiswas\\CBQRCode\\App\\": "app/",
            "ChinmoyBiswas\\CBQRCode\\Framework\\": "framework/"
        },
        "files": [
            "boot/compat.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
